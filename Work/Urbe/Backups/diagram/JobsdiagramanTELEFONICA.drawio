        <mxCell id="oehAQqX6saTjeceYBCwq-5" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="&lt;b&gt;BACKUP_LISTADO_DIARIO&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;Generate File at 00:00&lt;br&gt;This file will be save on NFS and it will contain all &lt;/div&gt;&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;backups files of the day before.&lt;br/&gt;&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); line-height: 19px;&quot;&gt;Copy from &lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;**D:\BACKUP\BACKUP_LISTADO_DIARIO.txt**&lt;/span&gt; &lt;/div&gt;&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); line-height: 19px;&quot;&gt;to &lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;**K:\REPORTES\backup_urbetrack_@yyyymmdd_ayer.txt**&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="460" x="810" y="210" as="geometry" />
        </mxCell>
        <mxCell id="oehAQqX6saTjeceYBCwq-7" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;BACKUP-PURGE&lt;br&gt;&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); line-height: 19px;&quot;&gt;&lt;div&gt;Mount disk K&lt;/div&gt;&lt;div&gt;DELETE files from &lt;span style=&quot;color: rgb(201, 209, 217); font-weight: bold;&quot;&gt;**K:\BACKUP21**&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(201, 209, 217); font-weight: bold;&quot;&gt;DELETE [URBETRACK] FULL &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(201, 209, 217); font-weight: bold;&quot;&gt;There is a retention file of 3 weeks (21 days)&lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(18, 19, 20), rgb(220, 221, 222)); color: light-dark(rgb(187, 190, 191), rgb(73, 75, 76));&quot;&gt; Delete FULL backups from &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: light-dark(rgb(18, 19, 20), rgb(220, 221, 222)); color: rgb(201, 209, 217); font-weight: bold;&quot;&gt;K:\BACKUP21\bkp_urbetrack_full_*.bak&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: light-dark(rgb(18, 19, 20), rgb(220, 221, 222)); color: rgb(201, 209, 217); font-weight: bold;&quot;&gt;&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); font-weight: normal; line-height: 19px;&quot;&gt;&lt;div&gt;PURGE URBETRACK DIFF&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(201, 209, 217); font-weight: bold;&quot;&gt;There is a retention file of 3 weeks (21 days)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Delete DIFF backups from &lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;&quot;K:\BACKUP21\bkp_urbetrack_diff_*.bak&quot;&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;PURGE URBETRACK LOG&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(201, 209, 217); font-weight: bold;&quot;&gt;There is a retention of one week&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Delete TLOG (OLDER than 1 week) from &lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;**&quot;K:\BACKUP21\bkp_urbetrack_log_*.bak&quot;**&lt;/span&gt; &lt;/div&gt;&lt;br&gt;&lt;div&gt;PURGE OTHERS FULL&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;There is a retention of 2 weeks on week (14 days).&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Delete FULL backups from &lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;**&quot;K:\BACKUP_GCABA\bkp_&lt;/span&gt;&lt;span style=&quot;color: #c9d1d9;font-style: italic;&quot;&gt;*_full_*&lt;/span&gt;&lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;.bak&quot;**&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;PURGE OTHERS DIFF&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;There is a retention of 1 week on week (1 week).&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Delete DIFF backups from &lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;**&quot;K:\BACKUP_GCABA\bkp_&lt;/span&gt;&lt;span style=&quot;color: #c9d1d9;font-style: italic;&quot;&gt;*_diff_*&lt;/span&gt;&lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;.bak&quot;**&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(201, 209, 217); font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="440" width="640" x="810" y="360" as="geometry" />
