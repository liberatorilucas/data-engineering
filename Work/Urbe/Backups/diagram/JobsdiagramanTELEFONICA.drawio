        <mxCell id="oehAQqX6saTjeceYBCwq-9" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;span style=&quot;color: #a5d6ff;&quot;&gt;BACKUP-REPORTE-RED&lt;br/&gt;&lt;/span&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div&gt;Save files on &lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(201, 209, 217); font-weight: bold;&quot;&gt;dir K:\BACKUP21\bkp* /O-D &amp;gt; D:\REPORTES\BACKUP_REPORTE_BACKUPS_EN_DISCO.txt&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;dir K:\BACKUP21\urbetrack_*.trn /O-D &amp;gt;&amp;gt; D:\REPORTES\BACKUP_REPORTE_BACKUPS_EN_DISCO.txt&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;Save info into table &lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(201, 209, 217); font-weight: bold;&quot;&gt;GPL.dbo.BACKUP_REPORTE_BACKUPS_EN_DISCO&lt;/span&gt; &lt;/div&gt;&lt;div&gt;from &lt;span style=&quot;color: rgb(201, 209, 217); font-weight: bold;&quot;&gt;D:\REPORTES\BACKUP_REPORTE_BACKUPS_EN_DISCO.txt&lt;/span&gt; &lt;/div&gt;&lt;br&gt;&lt;div&gt;Send email to &lt;span style=&quot;color: rgb(201, 209, 217); font-weight: bold;&quot;&gt;infra@urbetrack.com; geponce62@gmail.com&lt;/span&gt; with two subjects &lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(201, 209, 217); font-weight: bold;&quot;&gt;PT-EMPR.21 Reporte de Backups base urbetrack&lt;/span&gt; and &lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(201, 209, 217); font-weight: bold;&quot;&gt;PT-EMPR.21 Reporte de Backups resto de las bases&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;/div&gt;&lt;span style=&quot;color: #a5d6ff;&quot;&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="460" x="-232" y="210" as="geometry" />
        </mxCell>
        <mxCell id="oehAQqX6saTjeceYBCwq-11" edge="1" parent="1" source="oehAQqX6saTjeceYBCwq-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1.457;entryY=0.429;entryDx=0;entryDy=0;entryPerimeter=0;" target="oehAQqX6saTjeceYBCwq-9">
