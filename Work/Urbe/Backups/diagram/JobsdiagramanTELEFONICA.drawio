        <mxCell id="oehAQqX6saTjeceYBCwq-16" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;span style=&quot;color: rgb(165, 214, 255);&quot;&gt;BACKUP-URBETRACK-FULL-DIFF&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;span style=&quot;color: rgb(165, 214, 255);&quot;&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Helvetica; font-size: 12px; white-space: normal; background-color: rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;background-color: light-dark(rgb(251, 251, 251), rgb(21, 21, 21)); color: light-dark(rgb(63, 63, 63), rgb(183, 183, 183));&quot;&gt;Set @cifrado&amp;nbsp; for FULL and DIFF backup&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Helvetica; font-size: 12px; white-space: normal; background-color: rgb(251, 251, 251);&quot;&gt;Set week day to take FULL or DIFF depend on the new schedule.&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Helvetica; font-size: 12px; white-space: normal; background-color: rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;background-color: rgb(18, 19, 20); color: rgb(187, 190, 191); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; white-space: pre;&quot;&gt;If it&#39;s 7Sab - 3Mar - 5Jue (7,3,5) take FULL if not take DIFF (1Dom 2Lun 3Mar 4Mie 6Vie)&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Helvetica; font-size: 12px; white-space: normal; background-color: rgb(251, 251, 251);&quot;&gt;&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;div&gt;CURRENT SET UP If it&#39;s Saturday take FULL backup for the res of the days take DIFF.&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div&gt;if @weekday in (7) -- FULL: Sab (7)&lt;/div&gt;&lt;div&gt;&amp;nbsp; set @tipo_backup=&#39;FULL&#39;&lt;/div&gt;&lt;div&gt;else -- DIFF: el resto de los días &lt;/div&gt;&lt;div&gt;  set @tipo_backup=&#39;DIFF&#39;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;For [URBETRACK] database&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div&gt;We take FULL backup for [&lt;span style=&quot;color: rgb(165, 214, 255);&quot;&gt;URBETRACK&lt;/span&gt;] database. We create 6 .bak files per database&lt;/div&gt;&lt;div&gt;We verified the .bak&lt;/div&gt;&lt;div&gt;We take DIFF backup for [&lt;span style=&quot;color: rgb(165, 214, 255);&quot;&gt;URBETRACK&lt;/span&gt;] database. We create 3 .bak files per database&lt;/div&gt;&lt;div&gt;We verified the .bak &amp;nbsp; &lt;/div&gt;&lt;br&gt;&lt;div&gt;Retried Backup with limit @HHMM_limite=&#39;06:00&#39;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;The FULL and DIFF backups file are done in K:\BACKUP21**&lt;/span&gt; &lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;Send email to &lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;**&#39;geponce62@gmail.com&#39;**&lt;/span&gt; with two subjects &lt;/div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;**PT-RED BACKUP-URBETRACK-FULL-DIFF**&lt;/span&gt; OR &lt;/div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;**PT-RED BACKUP-URBETRACK-FULL-DIFF ERROR**&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;Execute Resto Full and Diff Job&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;EXEC msdb.dbo.sp_start_job N&#39;BACKUP-RESTO-FULL-DIFF&#39;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #c9d1d9;font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="540" width="820" x="459" y="820" as="geometry" />
        </mxCell>
        <mxCell id="oehAQqX6saTjeceYBCwq-17" edge="1" parent="1" source="oehAQqX6saTjeceYBCwq-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.189;entryY=0.011;entryDx=0;entryDy=0;entryPerimeter=0;" target="oehAQqX6saTjeceYBCwq-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
